{
  "name": "itprofelective-webpage-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "dlsud-submissions",
  "license": "MIT",
  "scripts": {
    "=== ORCHESTRATION ===": "",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run _dev",
    "dev:server": "npm --prefix server run _dev",
    "client": "npm run dev:client",
    "server": "npm run dev:server",
    "start": "npm --prefix server run _start",
    "=== SETUP ===": "",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "=== MONGODB ===": "",
    "mongo:dev": "npm run dev",
    "mongo:client": "npm run dev:client",
    "mongo:server": "npm run dev:server",
    "mongo:start": "npm run start",
    "mongo:install": "npm run install:all",
    "db:reset": "node server/scripts/dbReset.js",
    "db:schema": "node server/scripts/dbSchema.js",
    "db:seed": "node server/scripts/dbSeed.js",
    "=== CODE QUALITY ===": "",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,html,json,md,mdx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,less,html,json,md,mdx,yaml,yml}\"",
    "=== BUILD ===": "",
    "build": "npm --prefix client run _build",
    "preview": "npm --prefix client run _preview",
    "typecheck": "npm --prefix client run _typecheck"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "concurrently": "^9.2.3",
    "dotenv": "^16.6.1",
    "prettier": "^3.7.4",
    "supabase": "^2.48.3",
    "tsx": "^4.22.4",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlsud-submissions/itprofelective-webpage-system.git"
  },
  "bugs": {
    "url": "https://github.com/dlsud-submissions/itprofelective-webpage-system/issues"
  },
  "homepage": "https://github.com/dlsud-submissions/itprofelective-webpage-system#readme"
}
