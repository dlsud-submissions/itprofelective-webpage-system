{
  "info": {
    "name": "Issue #5 - Admin Routes",
    "description": "Verifies Epic B admin API routes for listing users, changing roles, banning/unbanning users, non-admin blocking, and self-ban protection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4321" },
    { "key": "adminEmail", "value": "admin-routes-admin@example.com" },
    { "key": "adminPassword", "value": "correcthorse123" },
    { "key": "userEmail", "value": "admin-routes-user@example.com" },
    { "key": "userPassword", "value": "correcthorse123" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "targetUserId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register regular target user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 or duplicate 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('targetUserId', body.user.id);",
              "  pm.test('Regular user starts as user and unbanned', () => {",
              "    pm.expect(body.user.role).to.eql('user');",
              "    pm.expect(body.user.isBanned).to.eql(false);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Admin Routes Target\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "2. Register admin test user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 or duplicate 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('adminId', body.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Admin Routes Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "3. Login regular user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('userToken', body.token);",
              "pm.collectionVariables.set('targetUserId', body.user.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "4. Non-admin cannot list users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 403', () => pm.response.to.have.status(403));",
              "pm.test('No user list returned', () => pm.expect(pm.response.json().users).to.be.undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
        "url": "{{baseUrl}}/admin/users"
      }
    },
    {
      "name": "5. Login admin user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('adminToken', body.token);",
              "pm.collectionVariables.set('adminId', body.user.id);",
              "pm.test('Logged-in user is admin after seed', () => pm.expect(body.user.role).to.eql('admin'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "6. Admin can list users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Returns a users array', () => pm.expect(body.users).to.be.an('array'));",
              "const target = body.users.find(user => user.email === pm.collectionVariables.get('userEmail'));",
              "pm.test('Target user is listed', () => pm.expect(target).to.exist);",
              "pm.test('passwordHash is not exposed', () => pm.expect(target.passwordHash).to.be.undefined);",
              "pm.collectionVariables.set('targetUserId', target.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/admin/users"
      }
    },
    {
      "name": "7. Admin changes target role to staff",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Role is staff', () => pm.expect(pm.response.json().user.role).to.eql('staff'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"staff\"\n}"
        },
        "url": "{{baseUrl}}/admin/users/{{targetUserId}}/role"
      }
    },
    {
      "name": "8. Admin bans target user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('isBanned is true', () => pm.expect(pm.response.json().user.isBanned).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isBanned\": true\n}"
        },
        "url": "{{baseUrl}}/admin/users/{{targetUserId}}/ban"
      }
    },
    {
      "name": "9. Banned target user cannot log in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 403', () => pm.response.to.have.status(403));",
              "pm.test('Explicit banned message', () => pm.expect(pm.response.json().error).to.eql('This account has been banned.'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "10. Admin unbans target user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('isBanned is false', () => pm.expect(pm.response.json().user.isBanned).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isBanned\": false\n}"
        },
        "url": "{{baseUrl}}/admin/users/{{targetUserId}}/ban"
      }
    },
    {
      "name": "11. Admin cannot ban self",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Self-ban is blocked', () => pm.expect(pm.response.json().error).to.eql('Admins cannot ban their own account.'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isBanned\": true\n}"
        },
        "url": "{{baseUrl}}/admin/users/{{adminId}}/ban"
      }
    }
  ]
}
