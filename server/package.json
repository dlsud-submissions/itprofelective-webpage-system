{
  "name": "itprofelective-webpage-system-mongo",
  "private": true,
  "version": "1.0.0",
  "description": "Golden Fur MIS - MongoDB finals variant (M01 User Registration & Authentication, M02 Staff Admin Panel)",
  "main": "server.js",
  "scripts": {
    "=== ORCHESTRATION ===": "",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server.js",
    "=== SETUP ===": "",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
